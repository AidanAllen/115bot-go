# ===== 必填 =====
# Telegram Bot Token，从 @BotFather 获取
BOT_TOKEN=

# ===== 网络 =====
# 自定义 Bot API 端点。留空走官方 https://api.telegram.org
# 一般不需要填；只有要访问 Telegram 不方便、需要走自建反代时才写：
#   http://127.0.0.1:8081/bot%s/%s
# （注意：它不能突破 20MB 限制，那是官方服务器的硬限制）
TG_API_ENDPOINT=

# 大文件下载（>20MB）用下面这两个：MTProto 直连，不需要 Docker，
# Windows 上跑 exe 同样有效。到 https://my.telegram.org/ 申请。
#
# 配置了：超过 20MB 的文件自动改走 MTProto 下载（官方 API 那条路必然失败，
#         不再浪费一趟往返）；官方下载失败时也会用 MTProto 兜一次。
# 不配置：超过 20MB 的文件无法转存。
# ⚠️ 属凭据，别提交到仓库，也别外传。
TG_API_ID=
TG_API_HASH=

# MTProto 会话保存路径（含 auth key，敏感）。留空用默认 ./data/tg.session.json
# TG_MTPROTO_SESSION=./data/tg.session.json

# ===== 权限 =====
# 机器人所有者 Telegram 用户 ID（仅作归属标记，供后续 web 控制台）。
# **不限制任何用户使用** —— v0.2.0 起任何人都能用，只是必须登录自己的 115。
# 留空则首个 /id 点「绑定为我」的人自动成为所有者。
OWNER_ID=

# ===== 存储 =====
DB_PATH=./data/115bot.db
TEMP_DIR=./data/tmp

# ===== 115 账号默认值（可运行时由每位用户自行覆盖）=====
# ⚠️ 多用户部署请全部留空。v0.2.0 起 cookie / UA / 通道 / 目录全部按用户存储
#    （/login /ua /channel /transfercid /setcid，一人一份，互相隔离），
#    这里的环境变量只作为「该用户尚未设置时」的兜底。
#
# DEFAULT_UA：留空则用内置 UA（Chrome 122 桌面版，与扫码登录签发的会话一致）。
#   不要写成 Edg/其它版本——UA 与会话不匹配会被 115 判为异常设备导致掉线。
# DEFAULT_UA=
#
# TRANSFER_CID / OFFLINE_CID：不要填。
#    它们不是「你的默认目录」，而是所有未设目录用户的兜底。填上你的 cid 之后，
#    陌生用户会拿着他自己的 cookie 往你的 cid 传 —— 那个 cid 在他网盘里根本不存在，
#    转存必然失败或落到意外位置。
OFFLINE_CID=
TRANSFER_CID=

# 默认转存通道：web / app / alipaymini / wechatmini，留空=web。
# 通道只影响客户端身份，不绑定账号，作为兜底是安全的；每位用户仍可用 /channel 自选。
UPLOAD_CHANNEL=

# ===== 115 凭据 =====
# /d 转存只需要 115 登录会话：用 /login 扫码，或 /cookie 手工粘贴。
# 不需要申请任何第三方 token。

# ===== 运行参数（都有内置默认，需要调整时才写）=====
# POLL_TIMEOUT=60s
# HTTP_TIMEOUT=30s
# MAX_DOWNLOAD_BYTES=0
# LOG_LEVEL=info
