# ============================================================
# 初始化部署说明
#
#   必填：BOT_TOKEN                          ← 没有它机器人起不来
#   可选：TG_API_ID / TG_API_HASH            ← 只有要转存 >20MB 的文件才需要
#
# 其余变量全部留空即可。115 的 cookie / UA / 转存通道 / 落盘目录
# 都按「每个 Telegram 用户」各自一份存进数据库，由用户在机器人里用
# /login（扫码）或 /cookie 自己配置，不需要在部署时预先写死。
# ============================================================

# ===== 必填 =====
# Telegram Bot Token，从 @BotFather 获取
BOT_TOKEN=

# ===== 网络 =====
# 自定义 Bot API 端点。留空走官方 https://api.telegram.org
# 一般不需要填；只有要访问 Telegram 不方便、需要走自建反代时才写：
#   http://127.0.0.1:8081/bot%s/%s
# （注意：它不能突破 20MB 限制，那是官方服务器的硬限制）
TG_API_ENDPOINT=

# 大文件下载（>20MB）用下面这两个：MTProto 直连，不需要 Docker，
# Windows 上跑 exe 同样有效。到 https://my.telegram.org/ 申请。
#
# 配置了：超过 20MB 的文件自动改走 MTProto 下载（官方 API 那条路必然失败，
#         不再浪费一趟往返）；官方下载失败时也会用 MTProto 兜一次。
# 不配置：超过 20MB 的文件无法转存，其余功能不受影响。
# ⚠️ 属凭据，别提交到仓库，也别外传。两个必须成对填写，否则启动直接报错。
TG_API_ID=
TG_API_HASH=

# ===== 网络代理（可选，一般不用管）=====
# 只有所在网络访问 Telegram / 115 必须走代理时才设置。
# ALL_PROXY：代理地址，例 socks5://127.0.0.1:1080
# NO_PROXY：不走代理的域名/网段，逗号分隔，例 localhost,127.0.0.1
# ALL_PROXY=
# NO_PROXY=

# ===== 权限 =====
# 机器人所有者 Telegram 用户 ID。它只是「机器人归谁」的标记（供后续 web
# 控制台 / 用户管理用），**不限制任何用户使用**——谁都能用，只是各登录各的 115。
#
# 留空：第一个在机器人里点「绑定为我」（/id 或 /setid 里都有这个按钮）的人
#       自动成为所有者。个人自用一般留空即可，无需手抄这串数字。
OWNER_ID=

# ===== 存储 =====
DB_PATH=./data/115bot.db
TEMP_DIR=./data/tmp

# ============================================================
# 「115 账号」相关兜底值 —— 初始化部署时全部不用设置，保持注释即可。
#
# 原因：cookie / UA / 转存通道 / 转存目录 / 离线目录，从当前版本起
# 都按「每个 Telegram 用户」独立存储（/login /cookie /ua /channel
# /transfercid /setcid，一人一份，互相隔离）。用户在机器人里点几下就能
# 配好自己的账号，无需（也不该）在部署时替所有人写死一份。
#
# 下面这些只是「某个用户自己还没设置」时的兜底。多用户共享一台机器人时
# 若填上你自己的 cid，等于让所有没配目录的人都拿他们的 cookie 往你的
# 目录里传——那个 cid 在他们网盘里根本不存在，转存必然失败或落错位置。
#
# 确实需要兜底时才取消下面某一行的注释（单用户自用通常也不需要）。
# ============================================================

# 兜底 User-Agent。内置值为 Chrome 122 桌面版，与扫码登录签发的会话一致；
# 不要写成 Edg/其它版本——UA 与会话不匹配会被 115 判为异常设备导致掉线。
# DEFAULT_UA=

# 兜底离线保存目录 cid（留空则跟随转存目录）
# OFFLINE_CID=

# 兜底转存目录 cid
# TRANSFER_CID=

# 兜底转存通道：web / app / alipaymini / wechatmini，留空=web。
# 通道只影响「上传时声明的客户端身份」，不绑定账号，作为兜底是安全的。
# UPLOAD_CHANNEL=

# ===== 115 凭据 =====
# /d 转存只需要 115 登录会话：用 /login 扫码，或 /cookie 手工粘贴。
# 不需要申请任何第三方 token。

# ===== 运行参数（都有内置默认，通常不用写；要改再取消注释）=====
# POLL_TIMEOUT=60s
# HTTP_TIMEOUT=30s
# MAX_DOWNLOAD_BYTES=0
# LOG_LEVEL=info
#
# MTProto 会话落盘位置（含 auth key，属敏感数据）。默认 ./data/tg.session.json，
# 一般不用改；只有要把会话放到别的盘/卷时才填。
# TG_MTPROTO_SESSION=./data/tg.session.json
