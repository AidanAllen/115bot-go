# 运行镜像：直接打包本机交叉编译好的静态二进制（build 阶段零依赖、不需要拉 golang 基础镜像）
# 源码构建版见 Dockerfile（多阶段，需要外网拉 golang:1.23-alpine + go mod download）
#
# 使用前先在仓库根目录产出 Linux 二进制：
#   make VERSION=0.1.3 linux
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata \
    && ln -snf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone

WORKDIR /app
COPY bin/115bot-linux-amd64 /app/115bot
RUN chmod +x /app/115bot

# 数据与临时目录通过卷挂载，保证容器重建不丢配置
VOLUME ["/app/data"]

# 非 root 运行
RUN adduser -D -u 10001 appuser && mkdir -p /app/data && chown -R appuser:appuser /app
USER appuser

ENV DB_PATH=/app/data/115bot.db \
    TEMP_DIR=/app/data/tmp \
    LOG_LEVEL=info \
    TZ=Asia/Shanghai

ENTRYPOINT ["/app/115bot"]
